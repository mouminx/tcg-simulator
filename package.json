{
  "name": "tcg-sim",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "extract-colors": "node scripts/extract-card-colors.mjs",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "verify-audio": "node scripts/verify-audio.mjs",
    "encode-audio": "node scripts/encode-audio.mjs",
    "build:desktop": "vite build --mode desktop",
    "desktop": "npm run build:desktop && electron .",
    "dist:desktop": "npm run build:desktop && electron-builder"
  },
  "dependencies": {
    "@fontsource/metamorphous": "^5.3.0",
    "@fontsource/noto-sans-runic": "^5.3.0",
    "@fontsource/quattrocento": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.10"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mouminx.cardsofarcana",
    "productName": "Cards of Arcana",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/* [0-9].*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    }
  },
  "description": "A collectible card game simulator. Build a guild, mine, forge, gather and craft.",
  "author": "mouminx"
}

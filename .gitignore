# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Pre-optimization source art. Kept locally so scripts/optimize-assets.mjs can
# re-encode at different sizes without a git checkout. Not shipped.
src/assets-original

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Timestamp stamp written by scripts/optimize-assets.mjs so it can tell what it has
# already processed. Generated state, not source.
src/assets/.optimized

# electron-builder output (installers). Built artefacts, not source.
release

# macOS conflict duplicates ("StationMerge 2.jsx", "wood 2.webp"). Something syncing
# ~/Documents created 112 of these inside src/ — byte-identical copies of tracked files.
# Harmless where they sit, but the asset globs match them (dead keys in the bundle) and a
# `git add -A` would commit them. Guard rather than remember.
* [0-9].*
* [0-9][0-9].*
